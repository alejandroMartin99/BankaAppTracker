# Copia a .env y rellena (no subas .env a Git)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Orígenes CORS permitidos (coma). Ejemplo:
# CORS_ORIGINS=http://localhost:4200,https://tu-app.vercel.app
# ENABLE_DIAGNOSTIC_ENDPOINT=false
# INVESTMENT_BENCHMARK_REFRESH_INTERVAL_HOURS=8
# INVESTMENT_BENCHMARK_REFRESH_IN_APP=true

# Modo demo (login con un clic en la app; crea el usuario en Supabase Auth)
# DEMO_LOGIN_ENABLED=true
# DEMO_USER_EMAIL=demo@tu-dominio.demo
# DEMO_USER_PASSWORD=contraseña_segura_solo_demo
